{
  "561:jsnode-server": {
    "intervalSeconds": 60,
    "mcp": true,
    "name": "jsnode-server",
    "port": 18808
  },
  "bin": {
    "jsnode-server": "dist/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@red-cup-engineering/fabricate-markdown-jsnode-operation-package-service": "0.1.1",
    "@red-cup-engineering/fold-directory-entries-into-services-section-form-service": "0.1.0",
    "@red-cup-engineering/http-server": "0.0.4",
    "@red-cup-engineering/jsnode-codecs": "0.1.0",
    "@red-cup-engineering/jsnode-computer": "0.4.0",
    "@red-cup-engineering/jsnode-topology": "0.2.0",
    "@red-cup-engineering/read-markdown-frontmatter-service": "0.1.4",
    "@red-cup-engineering/term-engineering-services-section": "0.2.1"
  },
  "description": "JSNode workspace analysis server for agents, including package, consumer, type-flow, and semantic executable-duplication tools over HTTP and MCP.",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "types": "./dist/cli.d.mts"
    },
    "./package.json": "./package.json",
    "./service": {
      "import": "./dist/service.mjs",
      "types": "./dist/service.d.mts"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/index.mjs",
  "name": "@red-cup-engineering/jsnode-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/jsnode-server.git"
  },
  "scripts": {
    "audit:boundary": "npm pack --dry-run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tmp/test-dist",
    "prepack": "npm run build",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "serve": "npm run build && node dist/cli.mjs serve",
    "test": "node --test --test-concurrency=1 \".tmp/test-dist/**/*.test.mjs\""
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.mts",
  "version": "0.5.2"
}
