{
  "bin": {
    "jsnode-server": "dist/cli.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/coding-context-projection-service": "0.3.4",
    "@red-cup-engineering/computer-data-engine": "0.11.2",
    "@red-cup-engineering/fabricate-markdown-jsnode-operation-package-service": "0.5.3",
    "@red-cup-engineering/javascript-deduplication-services-section": "0.2.3",
    "@red-cup-engineering/jsnode-codecs": "0.1.1",
    "@red-cup-engineering/jsnode-topology": "0.2.1",
    "@red-cup-engineering/jsnode-workspace-analysis-services-section": "0.1.3",
    "@red-cup-engineering/term-engineering-services-section": "0.3.0",
    "@red-cup-engineering/computer-platform": "0.5.3",
    "@red-cup-engineering/web-application": "0.3.0",
    "@red-cup-engineering/web-server": "0.3.0",
    "@red-cup-engineering/serve-model-context-protocol-over-http-service": "0.2.0",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.0",
    "@red-cup-engineering/javascript-computer": "0.2.6"
  },
  "description": "Workspace analysis operations and cached observation providers for the shared computer platform.",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "types": "./dist/cli.d.mts"
    },
    "./package.json": "./package.json",
    "./service": {
      "import": "./dist/service.mjs",
      "types": "./dist/service.d.mts"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/index.mjs",
  "name": "@red-cup-engineering/jsnode-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/jsnode-server.git"
  },
  "scripts": {
    "audit:boundary": "npm pack --dry-run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tmp/test-dist",
    "prepack": "npm run build",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "serve": "npm run build && node dist/cli.mjs serve",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 \".tmp/test-dist/**/*.test.mjs\""
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.mts",
  "version": "0.8.0"
}
