{
  "name": "@red-cup-engineering/jsnode-workspace-analysis-services-section",
  "version": "0.1.3",
  "type": "module",
  "description": "Projects observed JavaScript workspace sources into dependency, consumption, type-flow, topology, and workspace health carriers.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./workspace": {
      "import": "./dist/workspace.mjs",
      "types": "./dist/workspace.d.mts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "audit:boundary": "npm pack --dry-run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tmp/test-dist",
    "prepack": "npm run build",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test .tmp/test-dist/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/graph-data-service": "0.7.0",
    "@red-cup-engineering/javascript-computer": "0.2.6",
    "@red-cup-engineering/jsnode-topology": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
