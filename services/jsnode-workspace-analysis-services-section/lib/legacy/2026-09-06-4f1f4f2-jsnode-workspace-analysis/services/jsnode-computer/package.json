{
  "bin": {
    "jsnode-computer": "dist/cli.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/javascript-computer": "0.2.4",
    "@red-cup-engineering/jsnode-topology": "0.1.2"
  },
  "description": "Node workspace computing: package, dependency, consumer, type-flow, and semantic executable-duplication analysis over the JSNode workspace.",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "types": "./dist/cli.d.mts"
    },
    "./package.json": "./package.json",
    "./workspace": {
      "import": "./dist/workspace.mjs",
      "types": "./dist/workspace.d.mts"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/index.mjs",
  "name": "@red-cup-engineering/jsnode-computer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/jsnode-computer.git"
  },
  "scripts": {
    "audit:boundary": "npm pack --dry-run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tmp/test-dist",
    "prepack": "npm run build",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test \".tmp/test-dist/**/*.test.mjs\""
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.mts",
  "version": "0.4.0"
}
