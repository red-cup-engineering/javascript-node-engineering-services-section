{
  "name": "@red-cup-engineering/node-process-services-section",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared Node process boundary helpers: argv, environment, clock, entropy, stdio, command-result interpretation and lifecycle-record projection (execution itself is @red-cup-engineering/execute-javascript-node-command-service's job), config-file/data-root resolution, and service lifecycle events/records.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./clock": {
      "import": "./src/clock.mjs"
    },
    "./command": {
      "import": "./src/command.mjs"
    },
    "./config": {
      "import": "./src/config.mjs"
    },
    "./entrypoint": {
      "import": "./src/entrypoint.mjs"
    },
    "./entropy": {
      "import": "./src/entropy.mjs"
    },
    "./environment": {
      "import": "./src/environment.mjs"
    },
    "./lifecycle": {
      "import": "./src/lifecycle.mjs"
    },
    "./lifecycle-schema": {
      "import": "./src/lifecycle-schema-schema.mjs"
    },
    "./main-runner": {
      "import": "./src/main-runner.mjs"
    },
    "./stdio": {
      "import": "./src/stdio.mjs"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {}
}
